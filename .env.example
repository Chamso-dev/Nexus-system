# =============================================================================
# Nexus Crypto Bot — Environment Configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# =============================================================================

# ----------------------------------------------------------------------------
# Core / Runtime
# ----------------------------------------------------------------------------
NODE_ENV=development
# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Discord  (REQUIRED)
# ----------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# This is the ONLY secret Discord value. Keep it here in .env — never commit it.
DISCORD_TOKEN=your-discord-bot-token

# Application (client) ID from the same page → General Information.
# CLIENT_ID is accepted as an alias for DISCORD_CLIENT_ID.
CLIENT_ID=your-application-id
# DISCORD_CLIENT_ID=your-application-id   # (equivalent to CLIENT_ID)

# Your private server's guild ID. In development the bot auto-registers all
# slash commands to this guild on startup (instant), and — because
# RESTRICT_TO_GUILD defaults on when this is set — only operates in this server.
# ALLOWED_GUILD_ID is accepted as an alias for DISCORD_DEV_GUILD_ID.
ALLOWED_GUILD_ID=your-guild-id
# DISCORD_DEV_GUILD_ID=your-guild-id      # (equivalent to ALLOWED_GUILD_ID)

# Restrict the bot to ALLOWED_GUILD_ID. Defaults to true when ALLOWED_GUILD_ID
# is set; set to false to allow the bot to serve other guilds.
# RESTRICT_TO_GUILD=true

# Comma-separated list of Discord user IDs allowed to run /admin commands.
DISCORD_OWNER_IDS=

# ----------------------------------------------------------------------------
# Database (PostgreSQL) — used by Prisma
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# ----------------------------------------------------------------------------
# Redis (cache, rate limiting, cooldowns)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------------------------
# HTTP API / Health server
# ----------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Bearer token required for protected API endpoints (metrics, admin)
API_AUTH_TOKEN=change-me-to-a-long-random-string
# Shared secret used to validate inbound provider webhooks
WEBHOOK_SECRET=change-me-webhook-secret

# ----------------------------------------------------------------------------
# Market / Price data providers
# ----------------------------------------------------------------------------
# CoinGecko (free tier works without a key; Pro key optional)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ----------------------------------------------------------------------------
# On-chain data providers (per chain). Leave blank to disable that chain's
# live features — the adapter will report itself as "unconfigured".
# ----------------------------------------------------------------------------
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
SNOWTRACE_API_KEY=
# Bitcoin uses a public REST provider (blockstream/mempool.space) by default
BITCOIN_API_BASE_URL=https://blockstream.info/api
# Solana JSON-RPC endpoint
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ----------------------------------------------------------------------------
# News provider (optional)
# ----------------------------------------------------------------------------
CRYPTO_NEWS_API_KEY=
CRYPTO_NEWS_BASE_URL=https://min-api.cryptocompare.com/data/v2

# ----------------------------------------------------------------------------
# AI summarization (optional — for /news AI summaries)
# ----------------------------------------------------------------------------
AI_SUMMARY_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# Scheduler
# ----------------------------------------------------------------------------
# Master switch for background cron jobs
SCHEDULER_ENABLED=true
# Global cron cadence for the "every minute" pipeline
SCHEDULER_TICK_CRON=* * * * *

# ----------------------------------------------------------------------------
# Feature flags / limits
# ----------------------------------------------------------------------------
PREMIUM_ENABLED=true
FREE_MAX_WALLETS=3
FREE_MAX_ALERTS=5
PREMIUM_MAX_WALLETS=50
PREMIUM_MAX_ALERTS=100
DEFAULT_LOCALE=en
